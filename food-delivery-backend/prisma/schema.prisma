generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  RESTAURANT
  DELIVERY
  ADMIN
}

enum OrderStatus {
  PLACED
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  password        String

  // Multi-role system
  roles           Role[]    @default([CUSTOMER])
  activeRole      Role      @default(CUSTOMER)
  secondRole      Role?
  restaurantId    String?   // set when secondRole = RESTAURANT

  // Delivery agent fields
  vehicleType     String?
  vehicleNumber   String?
  isOnDuty        Boolean   @default(false)

  isBlocked       Boolean   @default(false)
  isSuspended     Boolean   @default(false)

  // Legacy location tracking (for delivery agents)
  isAvailable     Boolean   @default(false)
  currentLat      Float?
  currentLng      Float?

  restaurants     Restaurant[]   @relation("RestaurantOwner")
  customerOrders  Order[]        @relation("CustomerOrders")
  agentOrders     Order[]        @relation("AgentOrders")
  refreshTokens   RefreshToken[]
  cartItems       CartItem[]     @relation("UserCart")
  notifications   Notification[]
  addresses       Address[]
  favorites       Favorite[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([email])
  @@index([activeRole])
  @@index([isAvailable])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model CartItem {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation("UserCart", fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation("MenuItemCart", fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String   @default("Home")
  line1      String
  line2      String?
  city       String
  state      String?
  pincode    String?
  lat        Float?
  lng        Float?
  isDefault  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Favorite {
  id           String     @id @default(uuid())
  userId       String
  restaurantId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId])
}

model Restaurant {
  id             String     @id @default(uuid())
  name           String
  slug           String?    @unique
  ownerId        String
  description    String
  cuisines       String[]
  rating         Float      @default(0)
  reviewCount    Int        @default(0)
  imageUrl       String
  address        Json
  lat            Float?
  lng            Float?
  isOpen         Boolean    @default(true)
  statusNote     String?
  suspended      Boolean    @default(false)
  isApproved     Boolean    @default(true)
  deliveryRadius Float      @default(5)
  owner          User       @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]
  orders         Order[]
  favorites      Favorite[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([isOpen])
  @@index([rating])
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String
  price        Decimal    @db.Decimal(10, 2)
  category     String
  imageUrl     String
  isVeg        Boolean    @default(false)
  isAvailable  Boolean    @default(true)
  isBestseller Boolean    @default(false)
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cartItems    CartItem[] @relation("MenuItemCart")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, category])
  @@index([restaurantId, isAvailable])
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  restaurantId    String
  agentId         String?
  status          OrderStatus @default(PLACED)
  items           Json
  subtotal        Float       @default(0)
  deliveryFee     Float       @default(0)
  discount        Float       @default(0)
  total           Float       @default(0)
  deliveryAddress Json?
  cfOrderId           String?     @unique
  placedAt            DateTime    @default(now())
  deliveredAt         DateTime?
  estimatedDelivery   DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customer   User       @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  agent      User?      @relation("AgentOrders", fields: [agentId], references: [id])
  review     Review?

  @@index([customerId])
  @@index([restaurantId])
  @@index([agentId])
  @@index([status])
  @@index([customerId, status])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int
  comment   String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrder      Decimal      @db.Decimal(10, 2)
  maxUses       Int
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  restaurantId  String?
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Payment {
  id              String   @id @default(uuid())
  cfOrderId       String   @unique
  cfPaymentId     String?
  customerId      String
  restaurantId    String
  amount          Int
  status          String   @default("PENDING")
  itemsSnapshot   String
  deliveryAddress String
  couponCode      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model PaymentWebhook {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())

  @@index([eventId])
}

model Refund {
  id            String   @id @default(uuid())
  cfOrderId     String
  cfRefundId    String?  @unique
  amount        Int      // paise
  status        String   @default("PENDING")
  reason        String?
  initiatedBy   String   // admin userId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cfOrderId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  entityId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SiteConfig {
  id                 String   @id @default("singleton")
  maintenanceMode    Boolean  @default(false)
  newRestaurantReg   Boolean  @default(true)
  riderRegistrations Boolean  @default(true)
  cashOnDelivery     Boolean  @default(true)
  codMinOrder        Int      @default(0)
  maxDeliveryRadius  Int      @default(20)
  defaultDeliveryFee Int      @default(3000)
  requireApproval    Boolean  @default(false)
  allowBranches      Boolean  @default(true)
  maxMenuItems       Int      @default(200)
  requireEmailVerify Boolean  @default(false)
  autoConfirmOrders       Boolean   @default(false)
  maintenanceReason       String?
  maintenanceScheduledAt  DateTime?
  maintenanceEndsAt       DateTime?
  updatedAt               DateTime  @updatedAt
}
