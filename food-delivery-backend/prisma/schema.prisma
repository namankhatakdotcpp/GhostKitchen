generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  RESTAURANT
  DELIVERY
  ADMIN
}

enum OrderStatus {
  PLACED
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  password        String

  // Multi-role system
  roles           Role[]    @default([CUSTOMER])
  activeRole      Role      @default(CUSTOMER)
  secondRole      Role?
  restaurantId    String?   // set when secondRole = RESTAURANT

  // Delivery agent fields
  vehicleType     String?
  vehicleNumber   String?
  isOnDuty        Boolean   @default(false)

  // Legacy location tracking (for delivery agents)
  isAvailable     Boolean   @default(false)
  currentLat      Float?
  currentLng      Float?

  restaurants     Restaurant[]   @relation("RestaurantOwner")
  customerOrders  Order[]        @relation("CustomerOrders")
  agentOrders     Order[]        @relation("AgentOrders")
  refreshTokens   RefreshToken[]
  cartItems       CartItem[]     @relation("UserCart")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model CartItem {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation("UserCart", fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation("MenuItemCart", fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
}

model Restaurant {
  id             String     @id @default(uuid())
  name           String
  slug           String?    @unique
  ownerId        String
  description    String
  cuisines       String[]
  rating         Float      @default(0)
  imageUrl       String
  address        Json
  lat            Float?
  lng            Float?
  isOpen         Boolean    @default(true)
  deliveryRadius Float      @default(5)
  owner          User       @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]
  orders         Order[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String
  price        Decimal    @db.Decimal(10, 2)
  category     String
  imageUrl     String
  isVeg        Boolean    @default(false)
  isAvailable  Boolean    @default(true)
  isBestseller Boolean    @default(false)
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cartItems    CartItem[] @relation("MenuItemCart")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId, category])
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  restaurantId    String
  agentId         String?
  status          OrderStatus @default(PLACED)
  items           Json
  subtotal        Float       @default(0)
  deliveryFee     Float       @default(0)
  discount        Float       @default(0)
  total           Float       @default(0)
  deliveryAddress Json?
  cfOrderId       String?     @unique
  placedAt        DateTime    @default(now())
  deliveredAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer   User       @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  agent      User?      @relation("AgentOrders", fields: [agentId], references: [id])
  review     Review?

  @@index([customerId, status])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  rating    Int
  comment   String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrder      Decimal      @db.Decimal(10, 2)
  maxUses       Int
  usedCount     Int          @default(0)
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Payment {
  id              String   @id @default(uuid())
  cfOrderId       String   @unique
  cfPaymentId     String?
  customerId      String
  restaurantId    String
  amount          Int
  status          String   @default("PENDING")
  itemsSnapshot   String
  deliveryAddress String
  couponCode      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PaymentWebhook {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())

  @@index([eventId])
}
