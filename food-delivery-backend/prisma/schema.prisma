generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  RESTAURANT
  DELIVERY
  ADMIN
}

enum OrderStatus {
  PLACED
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String?
  password String

  // Multi-role system
  roles        Role[]  @default([CUSTOMER])
  activeRole   Role    @default(CUSTOMER)
  secondRole   Role?
  restaurantId String? // set when secondRole = RESTAURANT

  // Profile photo (optional; set during rider/restaurant onboarding)
  imageUrl      String?

  // Delivery agent fields
  vehicleType   String?
  vehicleNumber String?
  isOnDuty      Boolean @default(false)
  // Rider's operating city (collected at onboarding) and max distance they'll
  // travel from a restaurant, in km — used by assignDeliveryAgent to avoid
  // matching a rider in one city to an order in another.
  city          String?
  maxRadiusKm   Int     @default(20)

  isBlocked   Boolean @default(false)
  isSuspended Boolean @default(false)

  // Legacy location tracking (for delivery agents)
  isAvailable Boolean @default(false)
  currentLat  Float?
  currentLng  Float?

  restaurants       Restaurant[]       @relation("RestaurantOwner")
  customerOrders    Order[]            @relation("CustomerOrders")
  agentOrders       Order[]            @relation("AgentOrders")
  refreshTokens     RefreshToken[]
  cartItems         CartItem[]         @relation("UserCart")
  notifications     Notification[]
  addresses         Address[]
  favorites         Favorite[]
  riderLocation     RiderLocation?     @relation("UserRiderLocation")
  riderSessions     RiderSession[]     @relation("UserRiderSessions")
  reportedIncidents Incident[]         @relation("IncidentCreator")
  resolvedIncidents Incident[]         @relation("IncidentResolver")
  wallet            Wallet?            @relation("UserWallet")
  pushSubscriptions PushSubscription[]
  reviews           Review[]
  codSettlements    CODSettlement[]    @relation("RiderCODSettlements")
  riderCODPayments  RiderCODPayment[]  @relation("RiderCODPayments")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([email])
  @@index([activeRole])
  @@index([isAvailable])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model CartItem {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation("UserCart", fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation("MenuItemCart", fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   @default("Home")
  line1     String
  line2     String?
  city      String
  state     String?
  pincode   String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Favorite {
  id           String     @id @default(uuid())
  userId       String
  restaurantId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@index([userId])
}

model Restaurant {
  id             String     @id @default(uuid())
  name           String
  slug           String?    @unique
  ownerId        String
  description    String
  cuisines       String[]
  rating         Float      @default(0)
  reviewCount    Int        @default(0)
  imageUrl       String
  address        Json
  // Scalar mirror of address.city — kept in sync by createRestaurant/
  // updateRestaurant. Needed because Prisma's `distinct` can't operate on a
  // JSON field, and city-based rider matching needs an indexable column.
  city           String?
  lat            Float?
  lng            Float?
  isOpen         Boolean    @default(true)
  statusNote     String?
  openingTime    String?
  closingTime    String?
  suspended      Boolean    @default(false)
  isApproved     Boolean    @default(true)
  deliveryRadius Float      @default(5)
  owner          User       @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems       MenuItem[]
  orders          Order[]
  favorites       Favorite[]
  reviews         Review[]
  codSettlements  CODSettlement[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([isOpen])
  @@index([rating])
  @@index([city])
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  description  String
  price        Decimal    @db.Decimal(10, 2)
  category     String
  imageUrl     String
  isVeg        Boolean    @default(false)
  isAvailable  Boolean    @default(true)
  isBestseller Boolean    @default(false)
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cartItems    CartItem[] @relation("MenuItemCart")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, category])
  @@index([restaurantId, isAvailable])
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  restaurantId    String
  agentId         String? // rider who has ACCEPTED — confirmed assignment
  // Rider who has been OFFERED this order but hasn't responded yet. Set by
  // assignDeliveryAgent, cleared by the accept/reject endpoints (or by the
  // stale-offer sweep in the reassignment job). agentId is only ever set
  // once the offered rider actually accepts.
  pendingAgentId  String?
  agentOfferedAt  DateTime?
  status          OrderStatus @default(PLACED)
  items           Json
  subtotal        Float       @default(0)
  deliveryFee     Float       @default(0)
  discount        Float       @default(0)
  total           Float       @default(0)
  deliveryAddress Json?

  // ── Pricing/commission breakdown (all paise, all computed once at order
  // creation — see src/modules/orders/pricing.js). itemTotal duplicates
  // `subtotal` numerically; kept as its own column because the pricing spec
  // calls for it by this exact name for auditability, without renaming
  // `subtotal` everywhere it's already read across the codebase.
  itemTotal           Float? // == subtotal, sum of menu item price × qty
  restaurantPackaging Float? // 2.5% of itemTotal, 100% to restaurant
  gstOnItemTotal      Float? // 2.5% of itemTotal, tax passthrough
  gstOnDeliveryFee    Float? // 5% of deliveryFee, tax passthrough
  platformFee         Float? // admin-configured flat ₹ or % of itemTotal
  gstOnPlatformFee    Float? // 5% of platformFee, tax passthrough
  distanceKm          Float? // restaurant → delivery address, haversine; null if either end has no coordinates

  // ── 3-way revenue split, computed once at order creation from
  // PlatformSettings as they were AT THAT TIME (see pricingSnapshot) — an
  // admin changing the split tomorrow must never retroactively change what
  // a rider earned on an order placed today.
  restaurantPayout Float? // restaurantPackaging + split share of (deliveryFee + platformFee)
  riderPayout      Float? // split share of (deliveryFee + platformFee)
  adminRevenue     Float? // split share of (deliveryFee + platformFee)

  // Exact PlatformSettings values used to compute this order's pricing —
  // PlatformSettings is a singleton with no history table, so snapshotting
  // the literal numbers onto the order (same pattern as Payment.itemsSnapshot
  // elsewhere in this codebase) is the simplest way to make old orders immune
  // to later settings changes without building full settings versioning.
  pricingSnapshot     Json?
  // View-only dismissal from the shop's live Orders Board — distinct from
  // CANCELLED. The order's real status/lifecycle is untouched; this only
  // hides the card from THIS restaurant's board (e.g. a stuck/stale order
  // the shop wants out of view). Persisted rather than client-only state so
  // a page refresh doesn't bring the card back.
  hiddenFromShopBoard Boolean   @default(false)
  cfOrderId           String?   @unique
  placedAt            DateTime  @default(now())
  acceptedAt          DateTime? // restaurant accepted (CONFIRMED transition)
  readyAt             DateTime? // food ready for pickup (PREPARING → OUT_FOR_DELIVERY)
  pickedUpAt          DateTime? // rider collected from restaurant
  deliveredAt         DateTime?
  estimatedDelivery   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer       User             @relation("CustomerOrders", fields: [customerId], references: [id])
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  agent          User?            @relation("AgentOrders", fields: [agentId], references: [id])
  review         Review?
  codSettlement  CODSettlement?

  @@index([customerId])
  @@index([restaurantId])
  @@index([agentId])
  @@index([pendingAgentId])
  @@index([status])
  @@index([customerId, status])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([createdAt])
}

model Review {
  id           String     @id @default(uuid())
  orderId      String     @unique
  customerId   String
  restaurantId String
  rating       Int
  comment      String?
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer     User       @relation(fields: [customerId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([orderId])
  @@index([customerId])
  @@index([restaurantId])
}

// One row per delivered COD order — the financial settlement record.
// Tracks what the rider owes the platform (riderCODDue), what the platform
// owes the restaurant (restaurantPayable), and platform net earnings.
// Both settlement sides are tracked independently with nullable *SettledAt
// timestamps so admin can reconcile them on their own schedule.
model CODSettlement {
  id              String    @id @default(cuid())
  orderId         String    @unique
  riderId         String
  restaurantId    String

  // All amounts in paise (₹1 = 100 paise), matching the rest of the codebase.
  customerTotal      Int // total cash the customer paid the rider
  riderPayout        Int // rider's guaranteed earning — they KEEP this
  riderCODDue        Int // customerTotal - riderPayout — rider must hand to platform
  restaurantPayable  Int // platform owes restaurant (restaurantPayout)
  adminNet           Int // platform net after paying restaurant and rider
  gstCollected       Int // sum of all GST lines — platform holds this for remittance

  // Rider settlement: admin marks once the rider hands over cash
  riderSettledAt  DateTime?
  riderSettledBy  String?   // admin userId who marked it settled

  // Restaurant payout: admin marks once restaurant has been bank-transferred
  restaurantPaidAt  DateTime?
  restaurantPaidBy  String?   // admin userId who marked it paid

  createdAt DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  rider      User       @relation("RiderCODSettlements", fields: [riderId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([riderId, riderSettledAt])
  @@index([restaurantId, restaurantPaidAt])
  @@index([createdAt])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  minOrder      Decimal      @db.Decimal(10, 2)
  maxUses       Int
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  restaurantId  String?
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Payment {
  id              String   @id @default(uuid())
  cfOrderId       String   @unique
  cfPaymentId     String?
  customerId      String
  restaurantId    String
  amount          Int
  status          String   @default("PENDING")
  itemsSnapshot   String
  deliveryAddress String
  couponCode      String?
  pointsToRedeem  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model PaymentWebhook {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())

  @@index([eventId])
}

model RiderCODPayment {
  id           String    @id @default(cuid())
  riderId      String
  cfOrderId    String    @unique
  cfPaymentId  String?
  amountPaise  Int
  status       String    @default("PENDING")
  settledCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  rider        User      @relation("RiderCODPayments", fields: [riderId], references: [id])

  @@index([riderId, status])
}

model Refund {
  id          String   @id @default(uuid())
  cfOrderId   String
  cfRefundId  String?  @unique
  amount      Int // paise
  status      String   @default("PENDING")
  reason      String?
  initiatedBy String // admin userId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cfOrderId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  entityId  String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SiteConfig {
  id                     String    @id @default("singleton")
  maintenanceMode        Boolean   @default(false)
  newRestaurantReg       Boolean   @default(true)
  riderRegistrations     Boolean   @default(true)
  cashOnDelivery         Boolean   @default(true)
  codMinOrder            Int       @default(0)
  maxDeliveryRadius      Int       @default(20)
  defaultDeliveryFee     Int       @default(3000)
  requireApproval        Boolean   @default(false)
  allowBranches          Boolean   @default(true)
  maxMenuItems           Int       @default(200)
  requireEmailVerify     Boolean   @default(false)
  autoConfirmOrders      Boolean   @default(false)
  maintenanceReason      String?
  maintenanceScheduledAt DateTime?
  maintenanceEndsAt      DateTime?
  updatedAt              DateTime  @updatedAt
}

// Global, admin-configurable pricing/commission settings — singleton (one
// row, id always "singleton", same upsert-by-fixed-id pattern as SiteConfig
// above). Deliberately NOT per-restaurant/per-city; that's a known future
// extension, not a gap in this implementation. All ₹ amounts in paise.
// Orders snapshot these values onto themselves at creation time (see
// Order.pricingSnapshot) — editing this row never changes a past order's
// stored totals or payouts, only future ones.
model PlatformSettings {
  id                      String   @id @default("singleton")
  deliveryBaseFee         Int      @default(1000) // ₹10 — paise
  deliveryBaseDistanceKm  Float    @default(2.0)  // km included in base fee (no extra charge within this)
  deliveryPerKmFee        Int      @default(1000) // ₹10/km — paise (charged only beyond baseDistance)
  // "FLAT": platformFeeValue is a paise amount. "PERCENT": platformFeeValue
  // is a percentage of itemTotal (e.g. 5 means 5%).
  platformFeeMode         String   @default("FLAT")
  platformFeeValue        Float    @default(500) // ₹5 flat by default
  // 3-way split of (deliveryFee + platformFee), excluding all GST and
  // excluding restaurantPackaging. Must always sum to 100 — enforced in
  // platformSettings.schema.js, not just here.
  splitRestaurantPct      Float    @default(20)
  splitRiderPct           Float    @default(50)
  splitAdminPct           Float    @default(30)
  // ── Loyalty points / wallet (Item 1) ──────────────────────────────────────
  // Points earned per ₹1 of itemTotal on DELIVERED (not gross total — fees/
  // GST excluded). Default 0.1 = 1 point per ₹10 spent.
  freeDeliveryEnabled     Boolean  @default(false)
  freeDeliveryMinOrder    Int      @default(0)    // paise; 0 means free on all orders when enabled
  loyaltyEarnRate         Float    @default(0.1)
  // ₹ value of 1 point when redeemed at checkout, in paise. Default 100 = ₹1.
  loyaltyPointValuePaise  Int      @default(100)
  // Max % of an order's value that points redemption can cover, so points
  // alone can never zero out an order.
  loyaltyRedemptionCapPct Float    @default(20)
  // ── Rider payout — independent of delivery fee so admin can set a fair
  // guaranteed rate without it being coupled to what the customer pays.
  riderBasePay     Int     @default(2500)  // ₹25 base payout per delivery, paise
  riderPerKmPay    Int     @default(500)   // ₹5/km, paise
  riderMinPayout   Int     @default(2000)  // ₹20 minimum guaranteed payout, paise
  updatedAt               DateTime @updatedAt
}

// One row per customer — points balance only; full ledger lives in
// WalletTransaction. Same singleton-adjacent upsert-by-userId pattern as the
// rest of this app's per-user side tables (RiderLocation, etc.).
model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Int                 @default(0) // points, always a non-negative integer
  user         User                @relation("UserWallet", fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String // "EARNED" | "REDEEMED"
  points      Int // always positive — direction comes from `type`
  orderId     String?
  description String?
  createdAt   DateTime @default(now())

  @@index([walletId])
  @@index([orderId])
}

// A browser's Web Push subscription (Item 2) — one row per device/browser a
// user has granted notification permission on, since the same user can have
// several (phone + laptop). `endpoint` is unique per the Push API spec
// (one push service URL per subscribed device), used as the natural key for
// upsert-on-resubscribe and for pruning a subscription the push service
// reports as gone (410/404).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // subscription.keys.p256dh
  auth      String // subscription.keys.auth
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Live GPS position for a delivery rider, powering the admin live operations map.
// One row per rider (riderId unique); upserted on every POST /api/delivery/location.
model RiderLocation {
  id String @id @default(cuid())

  riderId String @unique

  latitude  Float
  longitude Float

  heading Float?
  speed   Float?

  lastSeenAt DateTime @updatedAt

  rider User @relation("UserRiderLocation", fields: [riderId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
}

// Operations incidents raised by admins (manually or from a fleet alert), for
// the Incident Center on the admin dashboard.
model Incident {
  id          String           @id @default(cuid())
  title       String
  description String?
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(OPEN)
  category    String? // e.g. RIDER_OFFLINE, ORDER_STUCK, RESTAURANT_OVERLOADED, DELIVERY_DELAYED, OTHER
  entityType  String? // RIDER | ORDER | RESTAURANT
  entityId    String?

  // null for incidents the system raised automatically from a fleet alert
  createdById    String?
  createdBy      User?     @relation("IncidentCreator", fields: [createdById], references: [id])
  resolvedById   String?
  resolvedBy     User?     @relation("IncidentResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  acknowledgedAt DateTime?

  // Escalation engine
  escalatedAt     DateTime?
  escalationCount Int       @default(0)
  lastNotifiedAt  DateTime?

  events    IncidentEvent[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

// Rider duty sessions — one row per check-in/check-out pair.
// Powers the "active hours" component of the rider performance score.
model RiderSession {
  id          String    @id @default(cuid())
  riderId     String
  rider       User      @relation("UserRiderSessions", fields: [riderId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationMin Float? // set when session is closed; null while still active
  createdAt   DateTime  @default(now())

  @@index([riderId, startedAt])
}

// Append-only activity log for an incident (timeline shown in the admin UI).
model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type       String // CREATED | SEVERITY_CHANGED | STATUS_CHANGED | ACKNOWLEDGED | RESOLVED | ESCALATED | NOTIFIED
  message    String?
  actorId    String? // admin user id, or null for system actions
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}
