# ─────────────────────────────────────────────────────────────────────────────
# GhostKitchen Backend — Environment Variables Reference
# Copy to .env and fill in your values before starting the server.
# [REQUIRED] variables cause a hard crash on startup if missing.
# [OPTIONAL] variables enable additional features when set.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production           # development | production
PORT=5000

# ── Database [REQUIRED] ───────────────────────────────────────────────────────
# Neon PostgreSQL (or any PostgreSQL-compatible URL)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/ghostkitchen?sslmode=require

# ── JWT [REQUIRED] ────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use DIFFERENT secrets for access vs refresh.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_minimum_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_minimum_32_chars
# JWT_EXPIRES_IN=15m          # default: 15m

# ── URLs [REQUIRED] ───────────────────────────────────────────────────────────
FRONTEND_URL=https://ghost-kitchen.vercel.app
BACKEND_URL=https://ghostkitchen.onrender.com
# Comma-separated list of allowed CORS origins (no trailing slashes)
ALLOWED_ORIGINS=https://ghost-kitchen.vercel.app

# ── Cashfree Payments [REQUIRED] ─────────────────────────────────────────────
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=PRODUCTION       # SANDBOX | PRODUCTION
# Optional: override for webhook HMAC secret (defaults to CASHFREE_SECRET_KEY)
# CASHFREE_CLIENT_SECRET=

# ── Redis [OPTIONAL — highly recommended for production] ─────────────────────
# REDIS_URL is used by:
#   1. Socket.IO Redis adapter  — required for multi-instance socket fan-out
#   2. Rate-limit Redis store   — required for shared rate limits across instances
#   3. Fallback key-value cache when Upstash REST is not configured
# For Upstash ioredis-compatible URL: rediss://default:TOKEN@hostname:6379
REDIS_URL=rediss://default:TOKEN@global-hostname.upstash.io:6379

# Upstash REST client — used for the application-level cache (restaurants,
# config, analytics). Can coexist with REDIS_URL above.
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── Sentry [OPTIONAL] ────────────────────────────────────────────────────────
# Error monitoring. Silently disabled when not set.
SENTRY_DSN=https://your-key@sentry.io/project-id

# ── Email — Resend [OPTIONAL] ─────────────────────────────────────────────────
# Transactional email. All sends are silently skipped when not set.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=GhostKitchen <noreply@ghostkitchen.in>

# ── Web Push [OPTIONAL] ───────────────────────────────────────────────────────
# PWA push notifications (order accepted/out-for-delivery/delivered) that work
# even when the app/tab is closed — separate from the existing Socket.IO
# real-time updates, which only work while the app is open. Without these,
# subscriptions still get stored but no pushes are actually sent.
# Generate your OWN pair (do not reuse any pair found in this repo's history
# or docs) with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service may use to reach you about this VAPID
# identity — any mailto: or https: URL works.
VAPID_SUBJECT=mailto:admin@ghostkitchen.in

# ── Admin Bootstrap [REQUIRED once, then DELETE] ─────────────────────────────
# One-time secret used with POST /bootstrap-admin to grant ADMIN role.
# Remove from Render env vars immediately after first admin account is created.
# BOOTSTRAP_SECRET=your_one_time_secret

# ── Feature Flags [OPTIONAL] ─────────────────────────────────────────────────
# ALLOW_SEED=false            # Never set true in production
# LOG_LEVEL=info              # error | warn | info | debug
