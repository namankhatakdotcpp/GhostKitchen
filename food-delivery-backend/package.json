{
  "name": "food-delivery-backend",
  "version": "1.0.0",
  "description": "GhostKitchen Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node scripts/migrate-deploy.js && node src/server.js",
    "start:dev-no-migrate": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node prisma/seed.js",
    "db:deploy": "node scripts/migrate-deploy.js",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "db:status": "npx prisma migrate status",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate && node scripts/resolve-failed-migrations.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.0.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "@upstash/redis": "^1.37.0",
    "bcrypt": "^6.0.0",
    "cashfree-pg": "^5.1.0",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "axios": "^1.17.0"
  }
}
