# Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# API Configuration
# Development
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (Render backend URL)
# NEXT_PUBLIC_API_URL=https://ghostkitchen-api.onrender.com/api

# Next.js
NEXT_PUBLIC_APP_NAME=GhostKitchen
NEXT_PUBLIC_APP_ENVIRONMENT=development

# Customer care number for the "Call Customer Care" button on the profile
# page (tel: link, needs client-side access). Set the real number in your
# local .env.local / Vercel project settings — never commit the real value.
NEXT_PUBLIC_SUPPORT_PHONE=+910000000000
